BUILDER_BIND_IP=127.0.0.1
BUILDER_PORT=5055
TZ=Europe/Brussels
FLASK_SECRET_KEY=CHANGE_ME_RANDOM_64_HEX
BUILDER_ADMIN_USERNAME=
BUILDER_ADMIN_PASSWORD_HASH=
BUILDER_ADMIN_TOTP_SECRET=
BUILDER_SESSION_COOKIE_SECURE=true
BUILDER_SESSION_TIMEOUT_SECONDS=900
BUILDER_SESSION_ABSOLUTE_TIMEOUT_SECONDS=28800
BUILDER_AUTH_STATE_PATH=/volume1/docker/.docker-app-manager-auth-state
ALLOWED_GLPI_IMAGES=glpi/glpi:
ALLOWED_DB_IMAGES=mariadb:,mysql:
MAX_SCAN_ENTRIES=500
